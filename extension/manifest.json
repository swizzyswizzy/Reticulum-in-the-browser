{
  "manifest_version": 3,
  "name": "Reticulum Gateway",
  "version": "1.0.0",
  "description": "Otwieraj node'y Reticulum z przeglądarki przez rNode w sieci lokalnej.",
  "browser_specific_settings": {
    "gecko": {
      "id": "reticulum-gateway@local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Reticulum Gateway",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "omnibox": {
    "keyword": "r"
  },
  "protocol_handlers": [
    {
      "protocol": "ext+reticulum",
      "name": "Reticulum Gateway",
      "uriTemplate": "/home.html#/%s"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "http://*/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ]
}
